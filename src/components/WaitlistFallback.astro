---
// The waitlist form as static HTML, shown until the WaitlistForm island hydrates. Submitting needs
// the island, so the button stays disabled here (a no-JS submit would put the email in the URL).
---

<form class="waitlist-form" data-state="idle" novalidate>
  <label for="home-email">Email address</label>
  <div class="input-row">
    <input
      id="home-email"
      name="email"
      type="email"
      placeholder="you@example.com"
      required
      autocomplete="email"
      aria-describedby="email-status"
    />
    <button class="m3e-button m3e-button--size-m" type="submit" disabled>Notify me</button>
  </div>
  <p class="form-status" id="email-status" aria-live="polite">
    We’ll only write when something ships.
  </p>
</form>
